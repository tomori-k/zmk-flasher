{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZMK Flasher",
  "version": "0.1.0",
  "identifier": "dev.tomori.zmk-flasher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZMK Flasher",
        "width": 1000,
        "height": 720,
        "minWidth": 840,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
